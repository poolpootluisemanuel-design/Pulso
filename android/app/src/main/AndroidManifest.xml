<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Música en segundo plano: el servicio en primer plano
             (tipo mediaPlayback) mantiene el proceso vivo mientras
             suena la música, para que no se corte al salir de la app
             o al apagar la pantalla. Lo arranca/para el plugin
             PulsoAudio (ver AudioForegroundService.java). -->
        <service
            android:name=".AudioForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ubicación: precisa para el GPS, en segundo plano para que la
         grabación siga con la pantalla apagada (el plugin de GPS en
         segundo plano ya declara FOREGROUND_SERVICE_LOCATION y el
         servicio de tipo "location"; aquí falta solo el permiso de
         segundo plano, que Android 10+ pide aparte). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Pasos: el sensor de movimiento del teléfono (conteo en vivo
         mientras grabas) y Health Connect (pasos del día). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Health Connect: leer historial de pasos de más de 30 días.
         Lo declara el plugin de salud para los datos básicos; este
         permiso extra solo se usa si se pide acceso al historial. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Música local nativa: leer las canciones del teléfono con
         MediaStore (plugin DeviceMusic). Android 13+ usa el permiso
         granular READ_MEDIA_AUDIO; en Android 12 o menos se usa
         READ_EXTERNAL_STORAGE (maxSdkVersion 32). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Notificaciones (Android 13+): avisar de sesiones y retos.
         Se pide en el flujo de permisos (plugin PulsoPermissions);
         en Android 12 o menos no hace falta pedirlo. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Música en segundo plano: el servicio en primer plano de audio
         (plugin PulsoAudio). Son permisos normales, sin diálogo en
         tiempo de ejecución. El permiso de ubicación en segundo plano
         (FOREGROUND_SERVICE_LOCATION) lo declara el plugin de GPS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Wake lock del reproductor (ExoPlayer WAKE_MODE_NETWORK): mantiene
         CPU y WiFi despiertos mientras suena con la pantalla apagada.
         Permiso normal, sin diálogo en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
